---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import RdvSection from '../components/RdvSection.astro';
import Footer from '../components/Footer.astro';
import FooterBar from '../components/FooterBar.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: any;
  noRdvSection?: boolean;
}

const { title, description, canonical, ogImage, ogType, jsonLd, noRdvSection = false } = Astro.props;
const jsonLdItems = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#b86a85" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Nunito+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Nunito+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap" />
    </noscript>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <SEOHead {title} {description} {canonical} {ogImage} {ogType} />
    {site.analytics.umamiWebsiteId && (
      <script is:inline defer src={site.analytics.umamiSrc} data-website-id={site.analytics.umamiWebsiteId} data-domains="dryousra.ma"></script>
    )}
    {jsonLdItems.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body class="font-body text-text bg-white">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:text-rose focus:rounded">
      Aller au contenu principal
    </a>
    <Navbar />
    <main id="main-content">
      <slot />
    </main>
    {!noRdvSection && <RdvSection />}
    <Footer />
    <FooterBar />
    <WhatsAppButton />

    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('v');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      document.querySelectorAll('.rv').forEach((element) => observer.observe(element));
    </script>

    <script is:inline>
      (function () {
        function tagLinks() {
          var path = location.pathname;
          var segments = path.split('/').filter(Boolean);
          var pageRef = segments.length ? segments[segments.length - 1].replace(/-/g, ' ') : 'accueil';

          function track(link, eventName) {
            if (link.hasAttribute('data-umami-event')) return;
            var zone = link.closest('[data-cta-zone]');
            link.setAttribute('data-umami-event', eventName);
            link.setAttribute('data-umami-event-page', path);
            link.setAttribute('data-umami-event-zone', (zone && zone.dataset.ctaZone) || 'contenu');
          }

          document.querySelectorAll('a[href*="wa.me/"]').forEach(function (link) {
            try {
              var url = new URL(link.href);
              var text = url.searchParams.get('text') || 'Bonjour, je souhaite prendre rendez-vous au cabinet.';
              if (text.indexOf('via dryousra.ma') === -1) {
                text += ' (via dryousra.ma, ' + pageRef + ')';
              }
              var query = '?text=' + encodeURIComponent(text);
              url.searchParams.forEach(function (value, key) {
                if (key !== 'text') query += '&' + encodeURIComponent(key) + '=' + encodeURIComponent(value);
              });
              link.href = url.origin + url.pathname + query + url.hash;
            } catch (e) {
              return;
            }
            track(link, 'clic_whatsapp');
          });

          document.querySelectorAll('a[href^="tel:"]').forEach(function (link) {
            track(link, 'clic_telephone');
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', tagLinks);
        } else {
          tagLinks();
        }
      })();
    </script>
  </body>
</html>
