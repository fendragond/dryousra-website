const medicalProcedure = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: 'Harmonisation du visage (full face)',
  alternateName: ['harmonisation visage', 'full face Casablanca', 'harmonisation full face'],
  description: "Approche globale d'harmonisation du visage par injections, pour équilibrer les proportions et les volumes à Casablanca, au cabinet de Dr Yousra El Khadri.",
  procedureType: 'https://health-lifesci.schema.org/NoninvasiveProcedure',
  bodyLocation: 'Visage',
  followup: 'Effets visibles rapidement, affinés sur 2 à 3 semaines. Durée de l\'acide hyaluronique généralement 12 à 18 mois selon les zones.',
  preparation: 'Consultation d\'analyse sans injection. Plan personnalisé (zones, priorités, nombre de séances). Contre-indications vérifiées avant tout geste.',
  relevantSpecialty: { '@type': 'MedicalSpecialty', name: 'Aesthetic Medicine' },
