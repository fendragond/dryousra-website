    ],
  },
  {
    label: 'Autres soins associés',
    variant: 'rose' as const,
    links: [
      { text: 'HydraFacial pour l\'éclat', url: '/soins/soins-visage/hydrafacial' },
      { text: 'Microneedling pour la texture', url: '/soins/soins-visage/microneedling' },
