const medicalProcedure = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: "Injections de Radiesse (hydroxyapatite de calcium)",
  alternateName: ['Radiesse', 'hydroxyapatite de calcium', 'stimulateur de collagène'],
  description: "Injection d'hydroxyapatite de calcium qui restaure les volumes immédiatement et stimule la production de collagène sur la durée, pour redensifier le visage, le cou et les mains à Casablanca.",
  procedureType: 'https://health-lifesci.schema.org/NoninvasiveProcedure',
  bodyLocation: 'Visage, cou, mains',
  followup: 'Effet volumateur immédiat, stimulation du collagène sur 3 à 6 mois, durée 12 à 18 mois.',
