const title = 'Harmonisation du visage <em>(full face)</em>';

const faqItems = [
  {
    question: 'Combien de séances faut-il pour une harmonisation full face ?',
    answer: 'Cela dépend de votre visage et de vos objectifs. Une harmonisation complète se déroule souvent sur deux à trois séances espacées, pour ajuster progressivement l\'équilibre. Le nombre exact est défini lors de la consultation à Casablanca, après l\'analyse de vos proportions par Dr Yousra El Khadri.',
  },
  {
    question: 'Est-ce que ça change mon visage ?',
    answer: 'L\'objectif n\'est pas de changer votre visage, mais d\'en rééquilibrer les proportions tout en préservant votre expression. La démarche full face vise un résultat naturel : les proches remarquent souvent une impression reposée ou harmonieuse, sans identifier ce qui a été fait.',
  },
  {
    question: 'Quelle différence avec un lifting chirurgical ?',
    answer: 'Un lifting est une opération de chirurgie qui retend les tissus. L\'harmonisation full face est un acte de médecine esthétique, sans chirurgie ni anesthésie générale, fondé sur des injections qui restaurent volumes et proportions. Les deux démarches répondent à des situations différentes.',
  },
  {
    question: 'À partir de quel âge peut-on envisager une harmonisation du visage ?',
    answer: 'Il n\'y a pas d\'âge unique. Une harmonisation peut affiner les proportions d\'un visage jeune comme soutenir un visage plus mature. Ce qui compte est votre demande et l\'analyse réalisée en consultation au cabinet de Casablanca, pas un seuil d\'âge.',
  },
  {
    question: 'Les résultats sont-ils naturels ?',
    answer: 'Le naturel est au cœur de la démarche. En travaillant le visage dans son ensemble, par petites touches et sur plusieurs séances si besoin, Dr Yousra El Khadri recherche un équilibre discret plutôt qu\'une transformation visible.',
  },
  {
    question: 'Combien de temps durent les résultats ?',
    answer: 'L\'acide hyaluronique se résorbe progressivement, en général sur douze à dix-huit mois selon les zones et les produits. Un entretien annuel permet de conserver l\'équilibre obtenu, souvent avec une simple mise au point plutôt qu\'une reprise complète.',
  },
  {
    question: 'Y a-t-il des contre-indications ?',
    answer: 'Oui. La grossesse, l\'allaitement, une infection active sur la zone à traiter ou certaines maladies auto-immunes contre-indiquent le geste. Ces éléments sont vérifiés avant toute injection lors de la consultation au Quartier des Hôpitaux à Casablanca.',
  },
];

