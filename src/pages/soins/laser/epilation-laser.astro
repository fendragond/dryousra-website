  {
    label: 'Autres traitements laser',
    variant: 'rose' as const,
    links: [
      { text: 'Laser médical', url: '/soins/laser/laser-medical' },
      { text: 'Détatouage laser', url: '/soins/laser/detatouage' },
    ],
  },
];

const medicalProcedure = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: 'Épilation laser définitive',
  alternateName: ['épilation laser', 'épilation définitive', 'épilation laser Casablanca'],
  description: "Épilation laser définitive à Casablanca sur plateforme Cynosure Elite+ (Alexandrite 755 nm et Nd:YAG 1064 nm), adaptée à tous les phototypes, pour réduire durablement la pilosité.",
  procedureType: 'https://health-lifesci.schema.org/NoninvasiveProcedure',
  bodyLocation: 'Aisselles, maillot, jambes, visage, dos, bras',
  followup: "Réduction progressive de la pilosité sur 6 à 8 séances espacées de 4 à 6 semaines, puis séances d'entretien.",
  preparation: "Éviter l'exposition solaire avant la séance. Ne pas épiler à la cire ou à la pince. Consultation médicale préalable pour adapter les paramètres au phototype.",
