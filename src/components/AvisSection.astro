---
import avis from '../data/avis.json';

const googleReviewsUrl =
  'https://www.google.com/maps/place/?q=place_id:ChIJn2XdU0fXpwARi--WI-OvUyw';
---

<section class="sec sec-c">
  <div class="avis-wrap">
    <div class="sh rv">
      <div class="sl">Témoignages</div>
      <h2 class="st">Ce que disent <em>les patientes</em></h2>
    </div>

    <div class="avis-grid">
      {avis.map((avisItem) => {
        const paragraphs = avisItem.texte.split('\n\n');
        const initial = avisItem.prenom.charAt(0);

        return (
          <article class="avis-card">
            {avisItem.soin && <p class="avis-soin">{avisItem.soin}</p>}

            <div class="avis-quote">
              {paragraphs.map((paragraphe, index) => {
                const isFirst = index === 0;
                const isLast = index === paragraphs.length - 1;
                return (
                  <p>
                    {isFirst ? `\u00AB\u00A0${paragraphe}` : paragraphe}
                    {isLast ? `\u00A0\u00BB` : ''}
                  </p>
                );
              })}
            </div>

            <div class="avis-attr">
              <span class="avis-initial" aria-hidden="true">{initial}</span>
              <p class="avis-name">{avisItem.prenom}</p>
            </div>
          </article>
        );
      })}
    </div>

    <div class="avis-cta">
      <a href={googleReviewsUrl} class="btn bo" target="_blank" rel="noopener">
        Voir tous les avis Google
      </a>
    </div>
  </div>
</section>

<style>
  .avis-wrap {
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
  }

  .avis-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .avis-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .avis-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: 14px;
    padding: 2.25rem;
    border: 1px solid var(--rose-pale);
  }

  .avis-soin {
    margin: 0 0 1.25rem;
    font-family: var(--font-b);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rose);
  }

  .avis-quote p {
    margin: 0 0 0.9rem;
    font-family: var(--font-b);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text);
  }

  .avis-quote p:last-child {
    margin-bottom: 0;
  }

  .avis-quote {
    margin-bottom: 1.75rem;
  }

  .avis-attr {
    display: flex;
    align-items: center;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rose-pale);
  }

  .avis-initial {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--rose-pale);
    color: var(--rose);
    font-family: var(--font-d);
    font-size: 1.1rem;
    line-height: 1;
  }

  .avis-name {
    margin: 0 0 0 0.85rem;
    font-family: var(--font-b);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--charcoal);
  }

  .avis-cta {
    margin-top: 2.5rem;
    text-align: center;
  }
</style>
