const medicalProcedure = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: 'Skin Booster (bio-revitalisation)',
  alternateName: ['skin booster', 'bio-revitalisation', 'hydratation profonde de la peau'],
  description: "Injections intradermiques d'acide hyaluronique non réticulé pour améliorer l'hydratation, la qualité et l'éclat de la peau sans modifier les volumes, à Casablanca.",
  procedureType: 'https://health-lifesci.schema.org/NoninvasiveProcedure',
  bodyLocation: 'Visage, cou',
  followup: 'Résultats visibles dès la première séance, optimaux après 3 séances espacées de 4 semaines.',
